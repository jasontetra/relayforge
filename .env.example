MOCKOON_BASE_URL=http://127.0.0.1:8080

FIREBLOCKS_BASE_URL=https://api.fireblocks.io/v1
FIREBLOCKS_API_KEY=
FIREBLOCKS_SECRET_KEY="-----BEGIN PRIVATE KEY-----
-----END PRIVATE KEY-----"

ALLIUM_BASE_URL=https://api.allium.so
ALLIUM_API_KEY=

COINAPI_BASE_URL=https://rest.coinapi.io
COINAPI_API_KEY=

# Production: https://app.bitgo.com — test environment: https://app.bitgo-test.com
BITGO_BASE_URL=https://app.bitgo.com
BITGO_ACCESS_TOKEN=
# Substituted into {enterpriseId} in BitGo paths and query values on the real target.
BITGO_ENTERPRISE_ID=
# Same substitution on the mockoon target; defaults to the mock's enterprise.
BITGO_MOCK_ENTERPRISE_ID=5a7a5c5c5c5c5c5c5c5c5c5c

# ATB FDX 5.3. Host only — paths keep the /fdx prefix so mock and real share them.
# Preprod: https://preprod.api.atb.com — prod: https://api.atb.com
ATB_BASE_URL=https://preprod.api.atb.com
ATB_AUTH_URL=https://preprod.api.atb.com
ATB_API_KEY=
ATB_USERNAME=
ATB_PASSWORD=
ATB_CLIENT_ID=
# PKCS#1, PKCS#8, or unencrypted OpenSSH RSA. Node cannot sign OpenSSH PEM as-is.
ATB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
-----END RSA PRIVATE KEY-----"
# Substituted into {accountId} on the real target.
ATB_ACCOUNT_ID=
# Same substitution on mockoon; defaults to the unity-dependencies synthetic account.
ATB_MOCK_ACCOUNT_ID=syn-acct-0001

# Per-provider mock overrides, used when the target is Mockoon.
# Each unity-dependencies provider mock listens on its own port.
FIREBLOCKS_MOCKOON_BASE_URL=http://127.0.0.1:9001
ALLIUM_MOCKOON_BASE_URL=http://127.0.0.1:9002
COINAPI_MOCKOON_BASE_URL=http://127.0.0.1:9000
BITGO_MOCKOON_BASE_URL=http://127.0.0.1:9003
ATB_MOCKOON_BASE_URL=http://127.0.0.1:9004
